# The Unity project ID is also present in ProjectSettings/ProjectSettings.asset.
UNITY_PROJECT_ID=759b1c47-af76-43ce-9833-1071e350fd6a
UNITY_ENVIRONMENT=production
# Web application OAuth client ID from Google Cloud. Use the same value in Unity Dashboard's Google provider.
GOOGLE_CLIENT_ID=
# Generate a random 32+ character value. Never commit the real value.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Neon free Postgres pooled connection string. Keep it server-side only.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
